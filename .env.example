# =============================================================================
# 애플리케이션 설정
# =============================================================================
DEBUG=false
SECRET_KEY=change-me-to-random-secret-key
JWT_SECRET=change-me-to-random-jwt-secret  # 최소 32자 이상 필수 (미만 시 HMAC 경고 발생)

# 거래 환경: paper(모의) / live(실전)
TRADING_ENV=paper

# =============================================================================
# 데이터베이스 (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockbot
POSTGRES_USER=stockbot
POSTGRES_PASSWORD=change-me-to-strong-password

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# 프론트엔드 + 인증
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
# Docker Compose 내부 서비스 간 통신용 (프론트→백엔드 프록시)
INTERNAL_API_URL=http://backend:8000
# 허용할 CORS 출처 (쉼표 구분, 예: http://localhost:3000,https://stockbot.choiji.kr)
ALLOWED_ORIGINS=http://localhost:3000
# 웹 대시보드 로그인 비밀번호 (빈 값이면 로그인 불가)
ADMIN_PASSWORD=
# JWT 토큰 만료 시간 (시간 단위, 기본 24)
JWT_EXPIRY_HOURS=24

# =============================================================================
# 한국투자증권 API (모의거래)
# https://openapi.koreainvestment.com
# =============================================================================
# KIS 종목 마스터파일 다운로드 베이스 URL (URL 변경 시 코드 수정 없이 대응)
KIS_MST_BASE_URL=https://new.real.download.dws.co.kr/common/master

KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=

# =============================================================================
# 한국투자증권 API (실전거래)
# =============================================================================
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# =============================================================================
# 네이버 검색 API
# https://developers.naver.com
# =============================================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# =============================================================================
# Open Dart API
# https://opendart.fss.or.kr
# =============================================================================
DART_API_KEY=

# =============================================================================
# 공공데이터포털 API (시가총액 데이터)
# https://www.data.go.kr → "금융위원회_주식시세정보" 활용 신청
# =============================================================================
DATA_GO_KR_API_KEY=

# =============================================================================
# Telegram Bot API
# https://t.me/BotFather
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

# =============================================================================
# 리스크 오버라이드 (임시 / 운영 조정용)
# =============================================================================
# 일일 최대 거래 횟수 오버라이드 (Sprint 3 LIVE 전환 전 임시 제한, 예: 3)
# 설정하지 않으면 settings 테이블의 daily_max_trade_count(기본 10) 사용
DAILY_MAX_TRADE_COUNT_OVERRIDE=

# =============================================================================
# Phase 8.5 Sprint 2: 풀 하한 폴백 + 동적 MIN_VOLUME_FLOOR
# =============================================================================
# 거래량 하한 결정 방식 (legacy=0.5 고정 / dynamic=조건부)
MIN_VOLUME_FLOOR_MODE=dynamic
# 어떤 분기도 이 이하로 내리지 않는 절대 하한
MIN_VOLUME_FLOOR_HARD=0.3
# 2차 스크리닝 통과 < 이 값이면 1차 통과 종목으로 보강
SECONDARY_POOL_FALLBACK_ENABLED=True
# Phase 8.6 Sprint 1 — 분기 D 손실 차단 (PO Sprint 2.6 흡수): 3 → 5 상향
SECONDARY_POOL_FALLBACK_THRESHOLD=5
# 폴백 포함 풀 최대 종목 수
SECONDARY_POOL_MAX=5
# Phase 8.6 Sprint 1 — 폴백 보강 종목수 상한
SECONDARY_POOL_FALLBACK_BACKFILL_HARD_CAP=5
# 전일 대비 이 이하 종목은 폴백 제외
FALLBACK_DROP_EXCLUDE_PCT=-3.0
# 폴백 종목 포지션 사이즈 배수 (0.5 = 반 포지션)
FALLBACK_POSITION_SIZE_RATIO=0.5
# 폴백 종목 손절 % (-1.5 = -1.5%)
FALLBACK_STOP_LOSS_PCT=-1.5
# Redis settings override 경로 활성화 (긴급 차단 시 False)
SETTINGS_OVERRIDE_ENABLED=True

# =============================================================================
# Phase 8.6 Sprint 1: G2 자동 롤백 R1~R4
# =============================================================================
AUTO_ROLLBACK_ENABLED=True
AUTO_ROLLBACK_R1_ENABLED=True   # 신호 0건 3거래일 연속
AUTO_ROLLBACK_R2_ENABLED=True   # 폴백 발동 3거래일 연속 (v0)
AUTO_ROLLBACK_R3_ENABLED=True   # tier 다양성 ≤1 5거래일
AUTO_ROLLBACK_R4_ENABLED=True   # 폴백 비중 ≥70% 1거래일

# =============================================================================
# Phase 8.6 Sprint 1: G3 1차→2차 통과율 회로차단기
# =============================================================================
CIRCUIT_BREAKER_ENABLED=True
# 일별 1차→2차 통과율 임계(이 미만이 N일 연속이면 발동, 0.10 = 10%)
CIRCUIT_BREAKER_PASS_RATE_THRESHOLD=0.10
# 회로차단기 발동 연속 거래일수
CIRCUIT_BREAKER_CONSECUTIVE_DAYS=3

# =============================================================================
# Phase 8.6 Sprint 2: 병렬 OR tier + ATR 분위수 캘리브레이션
# =============================================================================
# 병렬 OR tier 분기 활성화 (false 시 Sprint 1 직렬 동작 복원 — Kill-switch)
PARALLEL_OR_TIER_ENABLED=True
# 08:35 KOSPI200 ATR 분위수 캘리브레이션 잡 활성화 (false=정적 ATR_CEIL_HARD 사용)
ATR_CALIBRATION_ENABLED=True
# 캘리브레이션 방식: sma(20일 평균) 또는 ewma(λ=0.94)
ATR_CALIBRATION_METHOD=sma
# ATR 하한 (모든 tier 공통, 폴백 종목 포함, gap_open도 적용)
ATR_FLOOR=0.025
# ATR 상한 절대 한계 (gap_open 우회 시에도 적용, 동적 상한도 이 값 초과 금지)
ATR_CEIL_HARD=0.08
# 폴백 종목 ATR 상한 (동적 미적용)
ATR_CEIL_FALLBACK=0.05
# 동적 상한 곱계수 (P80×mult). shadow 그리드 {1.0,1.1,1.2,1.3} 중 실 진입값
ATR_CEIL_MULT=1.2
# KOSPI200 ATR 캘리브레이션 윈도우 (영업일 단위)
ATR_CALIBRATION_WINDOW_DAYS=20
# 폴백 3단 안전모드 신호 발행 중단 시간 (분, 기본 2시간)
SAFE_MODE_TIMEOUT_MIN=120
# ATR 캘리브레이션 OHLC 결측 허용 상한 (기본 30)
ATR_COVERAGE_GAP_MAX=30

# =============================================================================
# Phase 8.6 Sprint 3: 시간 필터 본 가드
# =============================================================================
# 시간대 진입 차단 마스터 토글 (false=전 시간대 허용)
TIME_FILTER_ENABLED=True

# =============================================================================
# Phase 8.6 Sprint 3: 거래량 급등 전략 (VolumeSurge)
# =============================================================================
# 거래량 급등 전략 활성화 (false=비활성)
VOLUME_SURGE_ENABLED=True
# Dry-run 모드 (true=신호 발행 전용, 주문 없음)
VOLUME_SURGE_DRY_RUN=True
# 거래량 급등 판정 비율 (현재/평균 ≥ 이 값)
VOLUME_SURGE_VOL_RATIO=5.0
# 호가 매수/매도 잔량 비율 하한 (≥ 이 값)
VOLUME_SURGE_BID_ASK_RATIO=2.0
# 진입 가격 상승률 하한 (예: 0.005=0.5%)
VOLUME_SURGE_PRICE_THRESHOLD=0.005
# 포지션 사이즈 비율 (0~1, 예: 0.30=30%)
VOLUME_SURGE_POSITION_SIZE=0.30

# =============================================================================
# Phase 8.6 Sprint 3: 신호 우선순위 큐
# =============================================================================
# 신호 우선순위 큐 활성화 (false=선입선출 복원)
SIGNAL_PRIORITY_QUEUE_ENABLED=True
# KIS kospi_code.mst 기반 KOSPI200 멤버십 일일 자동 동기화 (핫픽스 kospi200-real-200-backfill).
# default=false로 머지·배포 가능 — production에서 관찰 신호 보존 후 true 토글.
KOSPI200_MST_SYNC_ENABLED=false
